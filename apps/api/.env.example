# Copy to .env for local development. Every variable is validated in src/env.ts.
NODE_ENV=development
PORT=4000

DATABASE_URL=postgres://localhost:5432/forkyou_v2
# Used by `pnpm test`; tables are truncated between tests. Never point this at real data.
TEST_DATABASE_URL=postgres://localhost:5432/forkyou_v2_test

# Public URL of the web app. Users are sent here after login.
WEB_URL=http://localhost:3000

# GitHub OAuth app (https://github.com/settings/developers).
# Callback URL goes through the web app's /api proxy so the session cookie is first-party.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/github/callback

# Super admins (ADR 0009): GitHub ids, comma-separated. Not usernames, which can change hands.
# Find yours with: curl -s https://api.github.com/users/<your-username> | grep '"id"'
# Empty means no super admin, so nobody can appoint staff.
SUPER_ADMIN_GITHUB_IDS=
