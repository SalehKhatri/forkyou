{
  "name": "@forkyou/api",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/db/migrate.js && node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts"
  },
  "dependencies": {
    "@forkyou/shared": "workspace:^",
    "@hono/node-server": "^2.1",
    "@hono/zod-validator": "^0.9",
    "arctic": "^3.7",
    "drizzle-orm": "^0.45",
    "hono": "^4.13",
    "postgres": "^4.1",
    "zod": "^4.6"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31",
    "tsx": "^4.23",
    "vitest": "^5.1"
  },
  "files": [
    "dist",
    "drizzle"
  ]
}
